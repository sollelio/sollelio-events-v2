# Sollelio Events V2 — environment variables.
# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase project "events-v2" (ref icgsujzpcafqnqjozslj). The app refuses any
# other project URL.
NEXT_PUBLIC_SUPABASE_URL=https://icgsujzpcafqnqjozslj.supabase.co

# Publishable key (sb_publishable_…): Dashboard → Project Settings → API Keys.
# Public by design and inlined into the browser bundle. The app rejects secret
# (sb_secret_…) and legacy JWT keys (anon, service_role) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No Supabase privileged key (secret / service_role) is used.

# Public forms (ADR 0009). Server-only: never prefix with NEXT_PUBLIC_.
# While a required value is missing, public forms show "Formulário
# indisponível".
#
# The server connects as the database role public_form_service, which can
# only execute the two public form functions. The migration creates it
# without login; an operator enables it once per environment, in a database
# session (never in a file):
#   alter role public_form_service with login password '<generated>';
# Connection string: Supabase shared pooler, transaction mode (port 6543),
# user public_form_service.<project-ref>. Any other user is refused.
PUBLIC_FORMS_DATABASE_URL=
# PEM of the CA that signs the database certificate (Supabase dashboard:
# Database settings, SSL certificate). Multi-line, or with literal \n.
PUBLIC_FORMS_DATABASE_CA_CERT=
# Signs form render tokens and derives client fingerprints. At least 32
# random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PUBLIC_FORMS_SIGNING_SECRET=
# Optional. Number of trusted proxies that append to X-Forwarded-For (1-5).
# Set only when the app is reachable exclusively through such proxies (e.g.
# 1 with Vercel as the outermost edge); never when `next start` is exposed
# directly. Unset: no client address is trusted and only the per-link
# limits apply.
PUBLIC_FORMS_TRUSTED_PROXY_HOPS=
