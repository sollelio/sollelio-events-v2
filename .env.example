# Sollelio Events V2 — environment variables.
# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase project "events-v2" (ref icgsujzpcafqnqjozslj). The app refuses any
# other project URL.
NEXT_PUBLIC_SUPABASE_URL=https://icgsujzpcafqnqjozslj.supabase.co

# Publishable key (sb_publishable_…): Dashboard → Project Settings → API Keys.
# Public by design and inlined into the browser bundle. The app rejects secret
# (sb_secret_…) and legacy JWT keys (anon, service_role) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No privileged key is used yet. When one is needed, it gets a name WITHOUT the
# NEXT_PUBLIC_ prefix and is read only from server-only modules.
